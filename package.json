{
  "name": "password-manager",
  "version": "1.0.6",
  "description": "本地密码管理器：主密码加密存储，支持条目管理、密码生成与 TOTP 动态验证码",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:e2e": "electron test-e2e/renderer.e2e.js",
    "test:all": "npm test && npm run test:e2e",
    "build": "electron-builder --win"
  },
  "author": "CAIJIAXING",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.caijiaxing.password-manager",
    "productName": "密码管理器",
    "directories": {
      "output": "dist7",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "密码管理器-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "密码管理器"
    }
  }
}